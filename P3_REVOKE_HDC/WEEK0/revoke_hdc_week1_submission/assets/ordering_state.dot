digraph G {
rankdir=LR; graph [bgcolor="white", pad=0.2, nodesep=0.4, ranksep=0.55];
node [shape=box, style="rounded", fontname="Liberation Sans", fontsize=10];
edge [fontname="Liberation Sans", fontsize=9];
IDLE -> RX [label="packet"]; RX -> CRC; CRC -> VALIDATE [label="ok"]; CRC -> OUT [label="bad: code 3"];
VALIDATE -> GATE [label="structural+bit checks pass"]; VALIDATE -> OUT [label="refuse 4/5/6/7/8"];
GATE -> OUT [label="quarantine: code 1"]; GATE -> CAP [label="eligible"];
CAP -> OUT [label="no: code 2"]; CAP -> JOURNAL [label="yes"]; JOURNAL -> COMMIT; COMMIT -> OUT [label="code 0"];
IDLE -> LOOKUP [label="restore req"]; LOOKUP -> ORDER; ORDER -> RESTORING [label="active class head"]; ORDER -> OUT [label="code 7 or 10"];
RESTORING -> APPLY; APPLY -> RETIRE; RETIRE -> OUT [label="code 9"]; OUT -> IDLE;
subgraph cluster_life { label="record lifecycle"; style="dashed"; ACTIVE -> REST [label="head restore accepted"]; REST -> RETIRED [label="restore commit"]; }
}